<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>manual_capture</name>
  <version>0.1.0</version>
  <description>
    Standalone OAK-D Pro W capture GUI for labeling datasets: color, stereo
    left/right, center-aligned view and vehicle-aligned BEVs, launched together
    with manual driving.
  </description>

  <maintainer email="ohslo@example.com">ohslo</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>opencv4</depend>
  <depend>depthai</depend>
  <depend>qtbase5-dev</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- Launched alongside for manual driving; nothing depends on this package. -->
  <exec_depend>vehicle_bringup</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
