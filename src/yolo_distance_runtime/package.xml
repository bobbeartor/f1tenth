<?xml version="1.0"?>
<package format="3">
  <name>yolo_distance_runtime</name>
  <version>0.1.0</version>
  <description>Standalone distance collection and inference reusing existing YOLO and depth-source code.</description>
  <maintainer email="ohslo@example.com">ohslo</maintainer>
  <license>Proprietary</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>ament_index_cpp</depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>nlohmann_json</depend>
  <depend>depthai</depend>
  <depend>libopencv-dev</depend>
  <depend>point_cloud</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
