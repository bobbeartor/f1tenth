<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vehicle_launcher</name>
  <version>0.0.0</version>
  <description>Launch files for AutoDrive vehicle runtime.</description>
  <maintainer email="ohslo@example.com">ohslo</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>joy_initializer</exec_depend>
  <exec_depend>auto_control</exec_depend>
  <exec_depend>camera_driver</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>manual_control</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>vehicle_config</exec_depend>
  <exec_depend>vesc_initializer</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
